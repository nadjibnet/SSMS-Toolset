<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Standard VS command/menu identifiers (IDM_VS_MENU_TOOLS, etc.). -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidSsmsToolsetPackage">

    <Groups>
      <!-- A group that lives on the SSMS "Tools" top-level menu. -->
      <Group guid="guidSsmsToolsetCmdSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidSsmsToolsetCmdSet" id="ShowHelloCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSsmsToolsetCmdSet" id="ToolsMenuGroup" />
        <Strings>
          <ButtonText>SSMS Toolset: Hello</ButtonText>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <Symbols>
    <GuidSymbol name="guidSsmsToolsetPackage" value="{b7e3f5a1-9c24-4d8e-8f10-2a3b4c5d6e70}" />

    <GuidSymbol name="guidSsmsToolsetCmdSet" value="{c8f406b2-0d35-4e9f-9021-3b4c5d6e7f81}">
      <IDSymbol name="ToolsMenuGroup" value="0x1020" />
      <IDSymbol name="ShowHelloCommandId" value="0x0100" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
