<UserControl x:Class="SsmsToolset.UI.ToolsetPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource T.Window}">

    <UserControl.Resources>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource T.HeaderBg}"/>
            <Setter Property="Foreground"      Value="{DynamicResource T.HeaderFg}"/>
            <Setter Property="Padding"         Value="8,4,8,4"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource T.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{DynamicResource T.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.Border}"/>
            <Setter Property="Padding"     Value="6,3,6,3"/>
            <Style.Triggers>
                <!-- Theme-aware selection so selected rows/cells stay readable. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource T.SelBg}"/>
                    <Setter Property="Foreground"  Value="{DynamicResource T.SelFg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource T.SelBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource T.SubtleBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource T.TabBg}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource T.Border}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Margin="0,0,3,0" Padding="14,6">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T.TabSelBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource T.SubtleBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource T.SubtleBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TypeToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource T.SubtleBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource T.SubtleBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource T.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource T.AccentBtnBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T.AccentBtnFg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource T.TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DockBtn"
                        Content="Dock to side"
                        Background="{DynamicResource T.SubtleBtnBg}" Foreground="{DynamicResource T.SubtleBtnFg}"
                        BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        Padding="10,4,10,4" FontSize="12" Cursor="Hand"
                        ToolTip="Dock this panel inside SSMS"
                        Click="DockBtn_Click"/>
                <Button x:Name="OptionsBtn"
                        Content="&#x2699;  Options"
                        Margin="8,0,0,0"
                        Background="{DynamicResource T.SubtleBtnBg}" Foreground="{DynamicResource T.SubtleBtnFg}"
                        BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        Padding="10,4,10,4" FontSize="12" Cursor="Hand"
                        ToolTip="Options"
                        Click="OptionsBtn_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Theme" IsEnabled="False"/>
                            <MenuItem x:Name="ThemeDarkItem"  Header="Dark"  IsCheckable="True" Click="ThemeDark_Click"/>
                            <MenuItem x:Name="ThemeLightItem" Header="Light" IsCheckable="True" Click="ThemeLight_Click"/>
                            <Separator/>
                            <MenuItem Header="Open query in" IsEnabled="False"/>
                            <MenuItem x:Name="TargetToolsetItem" Header="Toolset query tab" IsCheckable="True" Click="TargetToolset_Click"/>
                            <MenuItem x:Name="TargetSsmsItem"    Header="New SSMS query"    IsCheckable="True" Click="TargetSsms_Click"/>
                            <Separator/>
                            <MenuItem Header="Objects list" IsEnabled="False"/>
                            <MenuItem x:Name="ShowColumnsItem" Header="Show Columns/Params column (slower load)"
                                      IsCheckable="True" Click="ShowColumns_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SSMS Toolset"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource T.Accent}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource T.BadgeBg}" CornerRadius="4"
                        Margin="12,0,0,0" Padding="8,2,8,2">
                    <TextBlock x:Name="DatabaseBadge"
                               Foreground="{DynamicResource T.BadgeFg}" FontSize="12"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="VersionText"
                           Foreground="{DynamicResource T.TextMuted}" FontSize="11"
                           VerticalAlignment="Bottom" Margin="8,0,0,3"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Padding="0,8,0,0">

            <!-- Primary tab: Objects -->
            <TabItem Header="Objects">
                <Border Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar: refresh + object-type toggles -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="RefreshBtn" Content="&#x21BB;  Refresh"
                                    Style="{StaticResource ToolBtn}" Click="RefreshBtn_Click"/>
                            <ToggleButton x:Name="ToggleTables"     Content="Tables"     Style="{StaticResource TypeToggle}" Click="TypeToggle_Click" Margin="14,0,0,0"/>
                            <ToggleButton x:Name="ToggleViews"      Content="Views"      Style="{StaticResource TypeToggle}" Click="TypeToggle_Click"/>
                            <ToggleButton x:Name="ToggleProcedures" Content="Procedures" Style="{StaticResource TypeToggle}" Click="TypeToggle_Click"/>
                            <ToggleButton x:Name="ToggleFunctions"  Content="Functions"  Style="{StaticResource TypeToggle}" Click="TypeToggle_Click"/>
                            <Button x:Name="SamplesBtn" Content="Samples &#x25BE;" Style="{StaticResource ToolBtn}"
                                    Margin="14,0,0,0" Click="SamplesBtn_Click"
                                    ToolTip="Ready-made sample queries">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show Migrations" Click="ShowMigrations_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <ToggleButton x:Name="SearchInDefinitions" DockPanel.Dock="Right"
                                          Content="In definitions" Style="{StaticResource TypeToggle}"
                                          Margin="8,0,0,0" Click="SearchMode_Click"
                                          ToolTip="Search inside view / procedure / function bodies"/>
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Background="{DynamicResource T.Input}" Foreground="{DynamicResource T.Text}"
                                         BorderBrush="{DynamicResource T.Border}" BorderThickness="1" Padding="8,6"
                                         FontSize="13" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock x:Name="SearchPlaceholder"
                                           Text="Search objects (accent-insensitive)..."
                                           Foreground="{DynamicResource T.TextMuted}" FontSize="13"
                                           Margin="10,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DockPanel>

                        <TextBlock x:Name="ObjectsStatus" Grid.Row="2"
                                   Foreground="{DynamicResource T.TextMuted}" FontSize="12" Margin="2,0,0,8"/>

                        <DataGrid x:Name="ObjectsGrid" Grid.Row="3"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Background="{DynamicResource T.Input}" Foreground="{DynamicResource T.Text}"
                                  BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                                  RowBackground="{DynamicResource T.Input}" AlternatingRowBackground="{DynamicResource T.AltRow}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource T.GridLine}"
                                  SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                  CellStyle="{StaticResource CellStyle}">
                            <DataGrid.Resources>
                                <ContextMenu x:Key="RowMenu">
                                    <MenuItem Header="Select Top 100 *"  Click="SelectTop100_Click" IsEnabled="{Binding IsTabular}"/>
                                    <MenuItem Header="Select Top 1000 (all columns)" Click="SelectTop1000_Click" IsEnabled="{Binding IsTabular}"/>
                                    <Separator/>
                                    <MenuItem Header="Update (all columns, commented)" Click="Update_Click" IsEnabled="{Binding IsTabular}"/>
                                    <MenuItem Header="Delete from (WHERE key)" Click="Delete_Click" IsEnabled="{Binding IsTabular}"/>
                                    <MenuItem Header="Execute (with parameters)" Click="Exec_Click" IsEnabled="{Binding IsExecutable}"/>
                                    <Separator/>
                                    <MenuItem Header="Script as CREATE" Click="ScriptCreate_Click"/>
                                </ContextMenu>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type"   Binding="{Binding TypeLabel}" Width="110"/>
                                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}"    Width="120"/>
                                <DataGridTextColumn Header="Name"   Binding="{Binding Name}"      Width="Auto" MinWidth="160"/>
                                <DataGridTextColumn x:Name="ColumnsParamsColumn"
                                                    Header="Columns/Params" Binding="{Binding ColumnsOrParams}"
                                                    Width="Auto" MinWidth="200" MaxWidth="900">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding ColumnsOrParams}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Secondary tab: Query -->
            <TabItem Header="Query">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource T.Card}"
                            BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SQL Query" Foreground="{DynamicResource T.Label}" FontSize="12" Margin="0,0,0,8"/>
                            <TextBox x:Name="InputBox"
                                     Background="{DynamicResource T.Input}" Foreground="{DynamicResource T.CodeText}"
                                     BorderBrush="{DynamicResource T.Border}" BorderThickness="1" Padding="8"
                                     FontFamily="Consolas" FontSize="13"
                                     AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="SELECT name, database_id, create_date&#x0A;FROM sys.databases&#x0A;ORDER BY name"/>
                            <Button x:Name="ExecuteBtn"
                                    Content="&#x25B6;  Execute"
                                    Background="{DynamicResource T.AccentBtnBg}" Foreground="{DynamicResource T.AccentBtnFg}"
                                    BorderThickness="0" Padding="18,6,18,6" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" FontSize="13" Cursor="Hand"
                                    Click="ExecuteBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource T.Card}"
                            BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="CopyResultsBtn" Content="Copy" Style="{StaticResource ToolBtn}"
                                            IsEnabled="False" Click="CopyResults_Click"
                                            ToolTip="Copy results to the clipboard (tab-separated)"/>
                                    <Button x:Name="ExportCsvBtn" Content="Export CSV" Style="{StaticResource ToolBtn}"
                                            Margin="6,0,0,0" IsEnabled="False" Click="ExportCsv_Click"
                                            ToolTip="Export results to a CSV file"/>
                                </StackPanel>
                                <TextBlock Text="Results" Foreground="{DynamicResource T.Label}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
                            <DataGrid x:Name="ResultGrid" Grid.Row="2"
                                      AutoGenerateColumns="True" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="{DynamicResource T.Input}" Foreground="{DynamicResource T.Text}"
                                      BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                                      RowBackground="{DynamicResource T.Input}" AlternatingRowBackground="{DynamicResource T.AltRow}"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource T.GridLine}" VerticalGridLinesBrush="{DynamicResource T.GridLine}"
                                      SelectionMode="Extended" SelectionUnit="Cell"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      CellStyle="{StaticResource CellStyle}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
